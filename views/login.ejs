<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Agenda de Contatos</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/login.css" />
    <script src="/js/form.js" defer></script>
    <script src="/js/showPassword.js" defer></script>
  </head>
  <body>
    <%- include('./partials/page-header.ejs') %>
    <main>
      <section class="form <%= error? 'error' : ''%>">
        <header class="form__header">
          <div class="form__icon">
            <span class="material-symbols-outlined"> lock </span>
          </div>
          <h2 class="title">Bem-vindo(a)</h2>
          <p>Faça login para acessar sua conta</p>
        </header>
        <form class="form__body" action="/login" method="post">
          <fieldset>
            <div class="form__field <%= error? 'form__field--error' : ''%>">
              <label class="form__label" for="email">E-mail</label>
              <div class="form__input-wrapper">
                <span class="material-symbols-outlined form__field__icon">
                  mail
                </span>
                <input
                  type="email"
                  name="email"
                  id="email"
                  placeholder="seu@email.com"
                  value="<%= error? data.email : ''%>"
                  required
                />
              </div>
            </div>
            <div class="form__field <%= error? 'form__field--error' : ''%>">
              <label class="form__label" for="password">Senha</label>
              <div class="form__input-wrapper">
                <span class="material-symbols-outlined form__field__icon">
                  lock
                </span>
                <input
                  type="password"
                  name="password"
                  id="password"
                  placeholder="Sua senha"
                  value="<%= error? data.password : ''%>"
                  required
                />
                <span
                  class="material-symbols-outlined form__field__icon"
                  id="show-password"
                >
                  visibility
                </span>
              </div>
            </div>
            <span
              class="form__field__message <%= error? 'form__field__message--error' : ''%>"
              ><%= error? error.message : ''%></span
            >
          </fieldset>
          <button class="btn" type="submit">Entrar</button>
        </form>
        <div class="form__division">
          <div class="line"></div>
          <span>ou</span>
          <div class="line"></div>
        </div>
        <footer class="form__footer">
          <p>
            Não tem uma conta?
            <a class="link" href="/register">Cadastre-se</a>
          </p>
        </footer>
      </section>
    </main>
    <footer></footer>
  </body>
</html>
